# Optional. Without a JWT 1Click charges an extra unauthenticated fee (register at https://partners.near-intents.org)
ONECLICK_JWT=
# Set to 1 to use simulated 1Click responses (no network, no funds). The UI shows a DEMO MODE banner.
DEMO_MODE=0
# Public base URL used when building invoice links (defaults to the request origin)
APP_URL=
# Optional. If set, invoices are stored in Postgres (hosted demo). Otherwise data/db.json is used.
DATABASE_URL=
